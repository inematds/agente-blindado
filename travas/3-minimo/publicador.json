{
  "_sobre": "Trava 3 · perfil PUBLICADOR: pode commitar e fazer push, mas cada push e cada envio passam por você (ask). Segredos continuam fechados.",
  "permissions": {
    "allow": [
      "Read", "Grep", "Glob", "Edit", "Write",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git add:*)", "Bash(git commit:*)"
    ],
    "ask": ["Bash(git push:*)", "Bash(gh:*)", "WebFetch"],
    "deny": [
      "Bash(git push --force:*)", "Bash(git push -f:*)", "Bash(rm -rf:*)", "Bash(sudo:*)",
      "Read(./.env)", "Read(./.env.*)", "Read(**/*.pem)", "Read(~/.ssh/**)"
    ]
  }
}
